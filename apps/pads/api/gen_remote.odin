		r := transport_set_song_mode(api, on)
		remote_answer(out, r, nil, remote_error(api, r))
	case "pads_transport_set_sync":
		sync := Sync(remote_enum(args, "sync", Sync_NAMES[:], &ok))
		if !ok {
			remote_answer(out, .Invalid_Argument, nil, "missing or wrong arguments")
			return
		}
		r := transport_set_sync(api, sync)
		remote_answer(out, r, nil, remote_error(api, r))
	case "pads_transport_set_clock_out":
		on := remote_bool(args, "on", &ok)
		if !ok {
			remote_answer(out, .Invalid_Argument, nil, "missing or wrong arguments")
			return
		}
		r := transport_set_clock_out(api, on)
		remote_answer(out, r, nil, remote_error(api, r))
	case:
		remote_answer(out, .Not_Found, nil, "no such method")
	}
}

@(private)
Result_NAMES := [?]string{"Ok", "Not_Found", "Invalid_Argument", "Busy", "Unsupported", "Io_Error"}

@(private)
Effect_Place_NAMES := [?]string{"Insert", "Bus", "Main", "Perf"}

@(private)
Key_Kind_NAMES := [?]string{"None", "Pad", "Bus"}

@(private)
Output_Kind_NAMES := [?]string{"Main", "Bus", "Pair"}

@(private)
Pad_Kind_NAMES := [?]string{"Sampler", "Audio", "Slicer", "Synth", "Plugin"}

@(private)
Pad_Mode_NAMES := [?]string{"One_Shot", "Gate", "Loop", "Hold"}

@(private)
Monitor_NAMES := [?]string{"Auto", "In", "Off"}

@(private)
Track_NAMES := [?]string{"None", "Pad", "Bus", "Main"}

@(private)
Device_NAMES := [?]string{"Sound", "Insert", "Volume", "Pan", "Send", "Eq"}

@(private)
Param_Unit_NAMES := [?]string{"None", "Decibels", "Hertz", "Milliseconds", "Percent", "Semitones", "Ratio"}

@(private)
Setting_Kind_NAMES := [?]string{"Bool", "Int", "Number", "Choice", "Text"}

@(private)
Setting_Group_NAMES := [?]string{"Appearance", "Audio", "Midi", "Sync", "Recording", "Project", "Plugins"}

@(private)
Topic_NAMES := [?]string{"Transport", "History", "Selection", "Pad", "Mixer", "Sequence", "Song", "Launcher", "Project", "Settings", "Recording", "Ui"}

@(private)
Metronome_Sound_NAMES := [?]string{"Beep", "Wood", "Stick", "Cowbell"}

@(private)
Sync_NAMES := [?]string{"Internal", "Midi_Clock", "Link"}

@(private)
remote_struct_Output :: proc(args: json.Object, name: string, ok: ^bool) -> Output {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Output
	v.kind = Output_Kind(remote_enum_or(obj, "kind", Output_Kind_NAMES[:], 0, ok))
	v.index = remote_i64_or(obj, "index", 0, ok)
	return v
}

@(private)
remote_struct_Param_Ref :: proc(args: json.Object, name: string, ok: ^bool) -> Param_Ref {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Param_Ref
	v.track = Track(remote_enum_or(obj, "track", Track_NAMES[:], 0, ok))
	v.index = remote_i64_or(obj, "index", 0, ok)
	v.device = Device(remote_enum_or(obj, "device", Device_NAMES[:], 0, ok))
	v.slot = remote_i64_or(obj, "slot", 0, ok)
	v.param = remote_i64_or(obj, "param", 0, ok)
	return v
}

@(private)
remote_struct_Slot_Ref :: proc(args: json.Object, name: string, ok: ^bool) -> Slot_Ref {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Slot_Ref
	v.place = Effect_Place(remote_enum_or(obj, "place", Effect_Place_NAMES[:], 0, ok))
	v.index = remote_i64_or(obj, "index", 0, ok)
	v.slot = remote_i64_or(obj, "slot", 0, ok)
	return v
}

