@(private)
Result_NAMES := [?]string{"Ok", "Not_Found", "Invalid_Argument", "Busy", "Unsupported", "Io_Error"}

@(private)
Audio_Warp_NAMES := [?]string{"Repitch", "Stretch"}

@(private)
Effect_Place_NAMES := [?]string{"Insert", "Bus", "Main", "Perf"}

@(private)
Key_Kind_NAMES := [?]string{"None", "Pad", "Bus"}

@(private)
Launch_Quantize_NAMES := [?]string{"End", "Bar", "Beat", "Now"}

@(private)
Output_Kind_NAMES := [?]string{"Main", "Bus", "Pair"}

@(private)
Pad_Kind_NAMES := [?]string{"Sampler", "Audio", "Slicer", "Synth", "Plugin"}

@(private)
Pad_Mode_NAMES := [?]string{"One_Shot", "Gate", "Loop", "Hold"}

@(private)
Monitor_NAMES := [?]string{"Auto", "In", "Off"}

@(private)
Track_NAMES := [?]string{"None", "Pad", "Bus", "Main"}

@(private)
Device_NAMES := [?]string{"Sound", "Insert", "Volume", "Pan", "Send", "Eq"}

@(private)
Param_Unit_NAMES := [?]string{"None", "Decibels", "Hertz", "Milliseconds", "Percent", "Semitones", "Ratio"}

@(private)
Play_Mode_NAMES := [?]string{"Pads", "Keyboard", "Velocity"}

@(private)
Scale_NAMES := [?]string{"Chromatic", "Major", "Minor", "Dorian", "Mixolydian", "Harmonic_Minor", "Major_Pentatonic", "Minor_Pentatonic", "Blues"}

@(private)
Chord_NAMES := [?]string{"Off", "Triad", "Seventh", "Power"}

@(private)
Sampling_NAMES := [?]string{"Hold", "Arm", "Threshold", "Bars"}

@(private)
Grid_NAMES := [?]string{"Quarter", "Eighth", "Eighth_Triplet", "Sixteenth", "Sixteenth_Triplet", "Thirty_Second", "Thirty_Second_Triplet", "Sixty_Fourth"}

@(private)
Pad_Lane_NAMES := [?]string{"Volume", "Pitch", "Eq_Low", "Eq_Mid", "Eq_High", "Cutoff", "Resonance"}

@(private)
Arp_Mode_NAMES := [?]string{"Up", "Down", "Up_Down", "Random", "As_Played"}

@(private)
Setting_Kind_NAMES := [?]string{"Bool", "Int", "Number", "Choice", "Text"}

@(private)
Setting_Group_NAMES := [?]string{"Appearance", "Audio", "Midi", "Sync", "Recording", "Project", "Plugins"}

@(private)
Topic_NAMES := [?]string{"Transport", "History", "Selection", "Pad", "Mixer", "Sequence", "Song", "Launcher", "Project", "Settings", "Recording", "Ui"}

@(private)
Metronome_Sound_NAMES := [?]string{"Beep", "Wood", "Stick", "Cowbell"}

@(private)
Sync_NAMES := [?]string{"Internal", "Midi_Clock", "Link"}

@(private)
remote_struct_Cc :: proc(args: json.Object, name: string, ok: ^bool) -> Cc {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Cc
	v.beat = remote_f64_or(obj, "beat", 0, ok)
	v.pad = remote_i64_or(obj, "pad", 0, ok)
	v.cc = remote_i64_or(obj, "cc", 0, ok)
	v.value = remote_i64_or(obj, "value", 0, ok)
	return v
}

@(private)
remote_struct_Midi_Fx :: proc(args: json.Object, name: string, ok: ^bool) -> Midi_Fx {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Midi_Fx
	v.repeat = remote_bool_or(obj, "repeat", false, ok)
	v.repeat_rate = Grid(remote_enum_or(obj, "repeat_rate", Grid_NAMES[:], 0, ok))
	v.repeat_gate = remote_f32_or(obj, "repeat_gate", 0, ok)
	v.arp = remote_bool_or(obj, "arp", false, ok)
	v.arp_mode = Arp_Mode(remote_enum_or(obj, "arp_mode", Arp_Mode_NAMES[:], 0, ok))
	v.arp_rate = Grid(remote_enum_or(obj, "arp_rate", Grid_NAMES[:], 0, ok))
	v.arp_octaves = remote_i64_or(obj, "arp_octaves", 0, ok)
	v.arp_gate = remote_f32_or(obj, "arp_gate", 0, ok)
	v.arp_latch = remote_bool_or(obj, "arp_latch", false, ok)
	return v
}

@(private)
remote_struct_Note :: proc(args: json.Object, name: string, ok: ^bool) -> Note {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Note
	v.start = remote_f64_or(obj, "start", 0, ok)
	v.length = remote_f64_or(obj, "length", 0, ok)
	v.pad = remote_i64_or(obj, "pad", 0, ok)
	v.pitch = remote_i64_or(obj, "pitch", 0, ok)
	v.velocity = remote_f32_or(obj, "velocity", 0, ok)
	v.probability = remote_f32_or(obj, "probability", 0, ok)
	v.muted = remote_bool_or(obj, "muted", false, ok)
	return v
}

@(private)
remote_struct_Output :: proc(args: json.Object, name: string, ok: ^bool) -> Output {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Output
	v.kind = Output_Kind(remote_enum_or(obj, "kind", Output_Kind_NAMES[:], 0, ok))
	v.index = remote_i64_or(obj, "index", 0, ok)
	return v
}

@(private)
remote_struct_Param_Ref :: proc(args: json.Object, name: string, ok: ^bool) -> Param_Ref {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Param_Ref
	v.track = Track(remote_enum_or(obj, "track", Track_NAMES[:], 0, ok))
	v.index = remote_i64_or(obj, "index", 0, ok)
	v.device = Device(remote_enum_or(obj, "device", Device_NAMES[:], 0, ok))
	v.slot = remote_i64_or(obj, "slot", 0, ok)
	v.param = remote_i64_or(obj, "param", 0, ok)
	return v
}

@(private)
remote_struct_Region :: proc(args: json.Object, name: string, ok: ^bool) -> Region {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Region
	v.take = remote_i64_or(obj, "take", 0, ok)
	v.at = remote_f64_or(obj, "at", 0, ok)
	v.start = remote_i64_or(obj, "start", 0, ok)
	v.end = remote_i64_or(obj, "end", 0, ok)
	v.gain_db = remote_f32_or(obj, "gain_db", 0, ok)
	v.pan = remote_f32_or(obj, "pan", 0, ok)
	v.fade_in = remote_f32_or(obj, "fade_in", 0, ok)
	v.fade_out = remote_f32_or(obj, "fade_out", 0, ok)
	v.mute = remote_bool_or(obj, "mute", false, ok)
	v.reverse = remote_bool_or(obj, "reverse", false, ok)
	return v
}

@(private)
remote_struct_Slot_Ref :: proc(args: json.Object, name: string, ok: ^bool) -> Slot_Ref {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Slot_Ref
	v.place = Effect_Place(remote_enum_or(obj, "place", Effect_Place_NAMES[:], 0, ok))
	v.index = remote_i64_or(obj, "index", 0, ok)
	v.slot = remote_i64_or(obj, "slot", 0, ok)
	return v
}

@(private)
remote_struct_Song_Clip :: proc(args: json.Object, name: string, ok: ^bool) -> Song_Clip {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Song_Clip
	v.slot = remote_i64_or(obj, "slot", 0, ok)
	v.lane = remote_i64_or(obj, "lane", 0, ok)
	v.at = remote_f64_or(obj, "at", 0, ok)
	v.length = remote_f64_or(obj, "length", 0, ok)
	v.start = remote_f64_or(obj, "start", 0, ok)
	v.part = remote_f64_or(obj, "part", 0, ok)
	v.phase = remote_f64_or(obj, "phase", 0, ok)
	v.transpose = remote_i64_or(obj, "transpose", 0, ok)
	v.mute = remote_bool_or(obj, "mute", false, ok)
	return v
}

@(private)
remote_struct_Song_Lane :: proc(args: json.Object, name: string, ok: ^bool) -> Song_Lane {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Song_Lane
	v.mute = remote_bool_or(obj, "mute", false, ok)
	v.solo = remote_bool_or(obj, "solo", false, ok)
	return v
}

@(private)
remote_struct_Tempo_Point :: proc(args: json.Object, name: string, ok: ^bool) -> Tempo_Point {
	obj, is := args[name].(json.Object)
	if !is {
		ok^ = false
		return {}
	}
	v: Tempo_Point
	v.beat = remote_f64_or(obj, "beat", 0, ok)
	v.bpm = remote_f64_or(obj, "bpm", 0, ok)
	v.ramp = remote_bool_or(obj, "ramp", false, ok)
	return v
}

