/*
Generates a Starlight-ready Markdown API reference page for one package from
the `.odin-doc` file `odin doc -doc-format` writes.

	odin run tools/docgen -- <file.odin-doc> <package dir> <out.md> [--strict]

Exported entities only (`@(private)` ones are skipped). With --strict, exits
with status 1 if any exported entity has no doc comment. Driven by
scripts/docs.sh.
*/
package docgen

import "core:fmt"
import doc "core:odin/doc-format"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strings"

h: ^doc.Header
current_pkg: ^doc.Pkg
type_pkg: map[^doc.Type]^doc.Pkg // named type → the package defining it

str :: proc(s: doc.String) -> string { return doc.from_string(&h.base, s) }
arr :: proc(a: $A/doc.Array($T)) -> []T { return doc.from_array(&h.base, a) }
entity :: proc(i: doc.Entity_Index) -> ^doc.Entity { return &arr(h.entities)[i] }
type_of :: proc(i: doc.Type_Index) -> ^doc.Type { return &arr(h.types)[i] }

main :: proc() {
	if len(os.args) < 4 {
		fmt.eprintln("usage: docgen <file.odin-doc> <package dir> <out.md> [--strict]")
		os.exit(2)
	}
	data, err := os.read_entire_file(os.args[1], context.allocator)
	if err != nil {
		fmt.eprintln("cannot read", os.args[1])
		os.exit(2)
	}
	read_err: doc.Reader_Error
	h, read_err = doc.read_from_bytes(data)
	if read_err != .None {
		fmt.eprintln("bad .odin-doc:", read_err)
		os.exit(2)
	}
	strict := len(os.args) > 4 && os.args[4] == "--strict"
	want, _ := filepath.abs(os.args[2], context.allocator)

	pkg: ^doc.Pkg
	for &p in arr(h.pkgs) {
		full, _ := filepath.clean(str(p.fullpath), context.temp_allocator)
		if full == want do pkg = &p
	}
	if pkg == nil {
		fmt.eprintln("package not found in .odin-doc:", want)
		os.exit(2)
	}
	current_pkg = pkg
	for &p in arr(h.pkgs) {
		for e in arr(p.entries) {
			ent := entity(e.entity)
			if ent.kind == .Type_Name do type_pkg[type_of(ent.type)] = &p
		}
	}
	sb := strings.builder_make()
	missing := write_page(&sb, pkg, os.args[2])
	if werr := os.write_entire_file(os.args[3], transmute([]u8)strings.to_string(sb)); werr != nil {
		fmt.eprintln("cannot write", os.args[3])
		os.exit(2)
	}
	if len(missing) > 0 {
		fmt.eprintfln("%s: %d exported symbols without docs: %s", os.args[2], len(missing), strings.join(missing, ", "))
		if strict do os.exit(1)
	}
}

// Returns the names of exported entities without docs.
write_page :: proc(sb: ^strings.Builder, pkg: ^doc.Pkg, dir: string) -> []string {
	slashed, _ := strings.replace_all(dir, "\\", "/")
	import_path := strings.concatenate({"fire:", strings.trim_prefix(strings.trim_suffix(slashed, "/"), "f_engine/")})
	pkg_docs := strings.trim_space(str(pkg.docs))
	fmt.sbprintfln(sb, "---")
	fmt.sbprintfln(sb, "title: %s", import_path)
	fmt.sbprintfln(sb, "description: %s", yaml_escape(first_sentence(pkg_docs, import_path)))
	fmt.sbprintfln(sb, "---")
	fmt.sbprintln(sb)
	fmt.sbprintfln(sb, "<!-- Generated by tools/docgen from doc comments. Do not edit: run scripts/docs.sh. -->")
	fmt.sbprintln(sb)
	fmt.sbprintfln(sb, "```odin\nimport %s \"%s\"\n```", str(pkg.name), import_path)
	fmt.sbprintln(sb)
	if pkg_docs != "" {
		write_docs(sb, pkg_docs)
		fmt.sbprintln(sb)
	}

	entries := slice.clone(arr(pkg.entries))
	slice.sort_by(entries, proc(a, b: doc.Scope_Entry) -> bool {
		return entity(a.entity).pos.offset < entity(b.entity).pos.offset if entity(a.entity).pos.file == entity(b.entity).pos.file else entity(a.entity).pos.file < entity(b.entity).pos.file
	})
	missing := make([dynamic]string)
	sections := [?]struct {
		title: string,
		kinds: bit_set[doc.Entity_Kind],
	}{
		{"Constants", {.Constant}},
		{"Types", {.Type_Name}},
		{"Procedures", {.Procedure, .Proc_Group}},
		{"Variables", {.Variable}},
	}
	for section in sections {
		written := false
		for e in entries {
			ent := entity(e.entity)
			if ent.kind not_in section.kinds || .Private in ent.flags do continue
			name := str(e.name)
			if strings.has_prefix(name, "_") do continue
			if !written {
				fmt.sbprintfln(sb, "## %s\n", section.title)
				written = true
			}
			docs := strings.trim_space(str(ent.docs))
			if docs == "" do append(&missing, name)
			write_entity(sb, name, ent, docs)
		}
	}
	return missing[:]
}

write_entity :: proc(sb: ^strings.Builder, name: string, ent: ^doc.Entity, docs: string) {
	fmt.sbprintfln(sb, "### %s\n", name)
	fmt.sbprintln(sb, "```odin")
	switch ent.kind {
	case .Constant:
		init := str(ent.init_string)
		ty := type_of(ent.type)
		if init != "" && ty.kind == .Basic && .Untyped in transmute(doc.Type_Flags_Basic)ty.flags {
			fmt.sbprintfln(sb, "%s :: %s", name, init)
		} else if init != "" {
			fmt.sbprintfln(sb, "%s : %s : %s", name, type_string(ent.type), init)
		} else {
			fmt.sbprintfln(sb, "%s :: %s", name, type_string(ent.type))
		}
	case .Type_Name:
		ty := type_of(ent.type)
		base := ty
		if ty.kind == .Named && len(arr(ty.types)) > 0 do base = type_of(arr(ty.types)[0])
		alias := .Type_Alias in ent.flags
		hidden := strings.contains(docs, "Fields are internal.")
		def := "struct {...}" if hidden && base.kind == .Struct else definition(ty)
		fmt.sbprintfln(sb, "%s :: %s%s", name, "" if !alias else "", def)
	case .Procedure:
		fmt.sbprintfln(sb, "%s :: %s", name, type_string(ent.type))
	case .Proc_Group:
		fmt.sbprintfln(sb, "%s :: proc{{", name)
		for g in arr(ent.grouped_entities) do fmt.sbprintfln(sb, "\t%s,", str(entity(g).name))
		fmt.sbprintln(sb, "}")
	case .Variable:
		fmt.sbprintfln(sb, "%s: %s", name, type_string(ent.type))
	case .Invalid, .Import_Name, .Library_Name, .Builtin:
	}
	fmt.sbprintln(sb, "```")
	fmt.sbprintln(sb)
	if docs != "" {
		write_docs(sb, docs)
		fmt.sbprintln(sb)
	}
	if ent.kind == .Type_Name && !strings.contains(docs, "Fields are internal.") do write_fields(sb, ent)
}

// Struct fields and enum values with their comments, as a list.
write_fields :: proc(sb: ^strings.Builder, ent: ^doc.Entity) {
	ty := type_of(ent.type)
	if ty.kind == .Named && len(arr(ty.types)) > 0 do ty = type_of(arr(ty.types)[0])
	if ty.kind != .Struct && ty.kind != .Enum do return
	fields := arr(ty.entities)
	any_docs := false
	for f in fields do any_docs ||= field_doc(entity(f), "") != ""
	if !any_docs do return
	fmt.sbprintln(sb, "| Field | Description |" if ty.kind == .Struct else "| Value | Description |")
	fmt.sbprintln(sb, "|-------|-------------|")
	prev := ""
	for f in fields {
		fe := entity(f)
		name := str(fe.name)
		d := field_doc(fe, prev)
		prev = trailing(fe)
		if name == "" || name == "_" do continue
		fmt.sbprintfln(sb, "| `%s` | %s |", name, table_escape(d))
	}
	fmt.sbprintln(sb)
}

// A field's description: comment lines above it plus its trailing comment.
// The doc format also reports the previous field's trailing comment as this
// field's leading docs; `prev` (that comment) filters it out.
field_doc :: proc(e: ^doc.Entity, prev: string) -> string {
	d := strings.trim_space(str(e.docs))
	c := trailing(e)
	if d == prev || (prev != "" && strings.trim_space(strings.trim_prefix(d, "//")) == prev) do d = ""
	if d != "" && c != "" do return strings.concatenate({d, " ", c})
	return d if d != "" else c
}

trailing :: proc(e: ^doc.Entity) -> string {
	return strings.trim_space(strings.trim_prefix(strings.trim_space(str(e.comment)), "//"))
}

// The type a name is defined as: its base type, spelled out.
definition :: proc(t: ^doc.Type) -> string {
	if t.kind == .Named && len(arr(t.types)) > 0 {
		base := arr(t.types)[0]
		bt := type_of(base)
		if bt.kind == .Named do return strings.concatenate({"distinct ", str(bt.name)})
		return type_string(base, true)
	}
	return type_string_of(t, true)
}

type_string :: proc(i: doc.Type_Index, expand := false) -> string {
	return type_string_of(type_of(i), expand)
}

type_string_of :: proc(t: ^doc.Type, expand := false) -> string {
	elem :: proc(t: ^doc.Type, n: int) -> string { return type_string(arr(t.types)[n]) }
	switch t.kind {
	case .Named:
		// Qualify types from other packages: `mem.Allocator`, `core.Node`.
		if pkg, ok := type_pkg[t]; ok && pkg != current_pkg && .Builtin not_in pkg.flags {
			// runtime.Allocator is what users know as mem.Allocator.
			if .Runtime in pkg.flags do return strings.concatenate({"mem." if str(t.name) == "Allocator" else "runtime.", str(t.name)})
			return strings.concatenate({str(pkg.name), ".", str(t.name)})
		}
		return str(t.name)
	case .Basic, .Generic:
		return str(t.name)
	case .Pointer:          return strings.concatenate({"^", elem(t, 0)})
	case .Multi_Pointer:    return strings.concatenate({"[^]", elem(t, 0)})
	case .Slice:            return strings.concatenate({"[]", elem(t, 0)})
	case .Dynamic_Array:    return strings.concatenate({"[dynamic]", elem(t, 0)})
	case .Array:            return fmt.aprintf("[%d]%s", t.elem_counts[0], elem(t, 0))
	case .Enumerated_Array: return fmt.aprintf("[%s]%s", elem(t, 0), elem(t, 1))
	case .Map:              return fmt.aprintf("map[%s]%s", elem(t, 0), elem(t, 1))
	case .Matrix:           return fmt.aprintf("matrix[%d, %d]%s", t.elem_counts[0], t.elem_counts[1], elem(t, 0))
	case .Simd_Vector:      return fmt.aprintf("#simd[%d]%s", t.elem_counts[0], elem(t, 0))
	case .Bit_Set:
		if len(arr(t.types)) > 1 do return fmt.aprintf("bit_set[%s; %s]", elem(t, 0), elem(t, 1))
		if len(arr(t.types)) > 0 do return fmt.aprintf("bit_set[%s]", elem(t, 0))
		return fmt.aprintf("bit_set[%d ..= %d]", t.elem_counts[0], t.elem_counts[1])
	case .Proc:
		cc := str(t.calling_convention)
		sb := strings.builder_make()
		strings.write_string(&sb, "proc")
		if cc != "" && cc != "odin" do fmt.sbprintf(&sb, " \"%s\"", cc)
		types := arr(t.types)
		strings.write_string(&sb, "(")
		if len(types) > 0 do strings.write_string(&sb, params(type_of(types[0]), false))
		strings.write_string(&sb, ")")
		if len(types) > 1 {
			res := type_of(types[1])
			if r := params(res, true); r != "" do fmt.sbprintf(&sb, " -> %s", r)
		}
		return strings.to_string(sb)
	case .Struct:
		if !expand do return "struct {...}"
		sb := strings.builder_make()
		strings.write_string(&sb, "struct")
		flags := transmute(doc.Type_Flags_Struct)t.flags
		if .Packed in flags do strings.write_string(&sb, " #packed")
		if .Raw_Union in flags do strings.write_string(&sb, " #raw_union")
		strings.write_string(&sb, " {\n")
		for f in arr(t.entities) {
			fe := entity(f)
			fmt.sbprintf(&sb, "\t%s%s: %s,\n", "using " if .Param_Using in fe.flags else "", str(fe.name) if str(fe.name) != "" else "_", type_string(fe.type))
		}
		strings.write_string(&sb, "}")
		return strings.to_string(sb)
	case .Enum:
		if !expand do return "enum {...}"
		sb := strings.builder_make()
		strings.write_string(&sb, "enum")
		if len(arr(t.types)) > 0 do fmt.sbprintf(&sb, " %s", elem(t, 0))
		strings.write_string(&sb, " {\n")
		for f in arr(t.entities) {
			fe := entity(f)
			init := str(fe.init_string)
			if init != "" do fmt.sbprintf(&sb, "\t%s = %s,\n", str(fe.name), init)
			else do fmt.sbprintf(&sb, "\t%s,\n", str(fe.name))
		}
		strings.write_string(&sb, "}")
		return strings.to_string(sb)
	case .Union:
		if !expand do return "union {...}"
		sb := strings.builder_make()
		strings.write_string(&sb, "union {\n")
		for v in arr(t.types) do fmt.sbprintf(&sb, "\t%s,\n", type_string(v))
		strings.write_string(&sb, "}")
		return strings.to_string(sb)
	case .Bit_Field:        return "bit_field {...}"
	case .Parameters:       return params(t, false)
	case .Invalid, .SOA_Struct_Fixed, .SOA_Struct_Slice, .SOA_Struct_Dynamic, .Relative_Pointer, .Relative_Multi_Pointer, .Soa_Pointer, .Fixed_Capacity_Dynamic_Array:
	}
	return str(t.name)
}

// "a, b: int, c := 2" for parameters; "T" or "(x: T, err: E)" for results.
params :: proc(t: ^doc.Type, results: bool) -> string {
	ents := arr(t.entities)
	if len(ents) == 0 do return ""
	parts := make([dynamic]string)
	named := false
	for e in ents {
		pe := entity(e)
		name := str(pe.name)
		init := str(pe.init_string)
		ty := type_string(pe.type)
		if .Param_Ellipsis in pe.flags do ty = strings.concatenate({"..", strings.trim_prefix(ty, "[]")})
		if .Param_CVararg in pe.flags do ty = strings.concatenate({"#c_vararg ", ty})
		if name != "" && name != "_" do named = true
		switch {
		case name == "" || name == "_":
			append(&parts, ty)
		case init != "" && pe.type == 0:
			append(&parts, fmt.aprintf("%s := %s", name, init))
		case init != "":
			append(&parts, fmt.aprintf("%s: %s = %s", name, ty, init))
		case:
			append(&parts, fmt.aprintf("%s: %s", name, ty))
		}
	}
	s := strings.join(parts[:], ", ")
	if results && (named || len(parts) > 1) do return strings.concatenate({"(", s, ")"})
	return s
}

// Doc comment text → Markdown: tab-indented lines become ```odin blocks, and a
// leading "[rt]" becomes a note that the procedure is realtime-safe.
write_docs :: proc(sb: ^strings.Builder, docs: string) {
	lines := strings.split_lines(docs)
	in_code := false
	for line, i in lines {
		is_code := strings.has_prefix(line, "\t")
		if is_code && !in_code {
			fmt.sbprintln(sb, "```odin")
			in_code = true
		} else if !is_code && in_code && strings.trim_space(line) != "" {
			fmt.sbprintln(sb, "```")
			in_code = false
		}
		if in_code {
			if strings.trim_space(line) == "" && (i + 1 >= len(lines) || !strings.has_prefix(lines[i + 1], "\t")) {
				fmt.sbprintln(sb, "```")
				in_code = false
				fmt.sbprintln(sb)
				continue
			}
			fmt.sbprintln(sb, strings.trim_prefix(line, "\t"))
			continue
		}
		l := line
		if i == 0 && strings.has_prefix(l, "[rt]") {
			l = strings.concatenate({"**Realtime-safe** (callable on the audio thread).", strings.trim_prefix(l, "[rt]")})
		}
		fmt.sbprintln(sb, l)
	}
	if in_code do fmt.sbprintln(sb, "```")
}

first_sentence :: proc(s: string, fallback: string) -> string {
	if s == "" do return fallback
	flat, _ := strings.replace_all(s, "\n", " ")
	if i := strings.index(flat, ". "); i >= 0 do return flat[:i + 1]
	return strings.trim_space(flat)
}

yaml_escape :: proc(s: string) -> string {
	q, _ := strings.replace_all(s, "\"", "\\\"")
	return strings.concatenate({"\"", q, "\""})
}

table_escape :: proc(s: string) -> string {
	r, _ := strings.replace_all(s, "|", "\\|")
	r, _ = strings.replace_all(r, "\n", " ")
	return r
}
